# VCS
.git
.gitignore

# Build outputs (regenerated inside the image)
build/
.dart_tool/
.packages
pubspec_overrides.yaml

# Non-web platforms (web-only build for now; un-ignore if mobile/desktop CI is added)
android/
ios/
macos/
linux/
windows/
!web/

# Docker / deploy files not needed in the build context (deploy/nginx.conf IS needed)
Dockerfile
docker-compose*.yml
.env
.env.*
.dockerignore

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
.metadata

# Logs
*.log